# Copy to publish.env, fill in values, load, then publish (never commit publish.env).
#
#   cp publish.env.example publish.env
#   ${EDITOR:-vi} publish.env
#   set -a && source publish.env && set +a
#   ./gradlew clean buildPlugin signPlugin publishPlugin
#
# Token: https://plugins.jetbrains.com/author/me/token

PUBLISH_TOKEN=perm:PASTE_TOKEN_HERE

# Optional: plugin signing (recommended for Marketplace)
# https://plugins.jetbrains.com/docs/intellij/plugin-signing.html
# CERTIFICATE_CHAIN=/absolute/path/to/chain.crt
# PRIVATE_KEY=/absolute/path/to/private.pem
# PRIVATE_KEY_PASSWORD=
